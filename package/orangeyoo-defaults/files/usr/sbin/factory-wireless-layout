#!/bin/sh
# Orangeyoo 2.0 factory wireless layout - S99 post-hook edition.
# Why here: this stack regenerates /etc/config/wireless via 'wifi config'
# AFTER uci-defaults (no ubus in uci-defaults stage), so a uci-defaults
# script can never stick. This hook runs at the very end of boot (S99,
# after network/wireless bring-up machinery), checks whether the factory
# identity SSIDs are already in place, and if not rewrites them from THIS
# unit's ART p20 (2.4G=+3, 5G=+4, 6G=+2 suffix naming) then reloads.
ART=/dev/mmcblk0p20
. /lib/functions/system.sh

BASE=$(dd if=$ART bs=512 count=1 2>/dev/null | head -c 6 | hexdump -v -e '6/1 ":%02x"' | cut -c2-)
[ -n "$BASE" ] || exit 0

# idempotence + boot readiness: wifi-scripts generates the wireless config
# asynchronously; wait (bounded, ~2 min) for the sections to appear.
S24=$(macaddr_add "$BASE" 3 | sed 's/://g' | tr 'a-z' A-Z | cut -c7-12)
n=0
while [ -z "$(uci -q get wireless.default_radio0_band0.ssid)" ] && [ $n -lt 60 ]; do
  sleep 2
  n=$((n + 1))
done
[ -n "$(uci -q get wireless.default_radio0_band0.ssid)" ] || exit 0

# OWE transition for an open 2.4G/5G network: the visible BSS stays open
# for old clients, a hidden OWE BSS (<ssid>_OWE) is advertised through the
# transition element. Clients that do OWE (Windows 11, Android 10+, iOS 13+)
# move to it automatically; Wi-Fi 7 (EHT/MLO) needs encryption, so without
# it every client stays on Wi-Fi 6 rates. Checked on the unit 2026-11-13:
# 5G 802.11be 160 MHz, 1.83/1.28 Gbit/s; open BSS 802.11ax only.
owe_pair() {
  local b=$1 o=default_radio0_band$1 w=owe_radio0_band$1 ssid
  [ "$(uci -q get wireless.$o.encryption)" = none ] || return 0
  uci -q get wireless.$w >/dev/null && return 0
  ssid=$(uci -q get wireless.$o.ssid)
  [ -n "$ssid" ] || return 0
  uci set wireless.$o.ifname="phy00.$b-0"
  uci set wireless.$o.owe_transition_ifname="phy00.$b-1"
  uci set wireless.$w=wifi-iface
  uci set wireless.$w.device="radio0_band$b"
  uci set wireless.$w.network='lan'
  uci set wireless.$w.mode='ap'
  uci set wireless.$w.ssid="${ssid}_OWE"
  uci set wireless.$w.hidden='1'
  uci set wireless.$w.encryption='owe'
  uci set wireless.$w.ieee80211w='2'
  uci set wireless.$w.ifname="phy00.$b-1"
  uci set wireless.$w.owe_transition_ifname="phy00.$b-0"
  changed=1
}

# One-time migration for units configured by images up to 1.0-rc3:
# 2.4G was HT40 (Wi-Fi 4 rates only) and 5G EHT80, below what the 4x4
# radios do (2.4G EHT40, 5G EHT160), and both were open (Wi-Fi 6 rates at
# most). Only the old default widths are bumped, and an OWE companion is
# added only to a band that is still open; user choices are left alone.
MIG=/etc/sbe-wifi-width-v2
if [ ! -e $MIG ]; then
  changed=
  [ "$(uci -q get wireless.radio0_band0.htmode)" = HT40 ] &&
    uci set wireless.radio0_band0.htmode='EHT40' && changed=1
  [ "$(uci -q get wireless.radio0_band1.htmode)" = EHT80 ] &&
    uci set wireless.radio0_band1.htmode='EHT160' && changed=1
  owe_pair 0
  owe_pair 1
  touch $MIG
  if [ -n "$changed" ]; then
    uci commit wireless
    /sbin/wifi reload >/dev/null 2>&1
    logger -t factory-wireless "migrated: 2.4G EHT40, 5G EHT160, OWE transition"
  fi
fi

# Factory layout once per install. Up to 1.0-rc5 it was re-applied on every
# boot whenever the 2.4G SSID did not match iStoreOS_<mac>_*, so any SSID
# the user set was reverted at the next reboot.
DONE=/etc/sbe-factory-wireless-v1
[ -e $DONE ] && exit 0
case "$(uci -q get wireless.default_radio0_band0.ssid)" in
  iStoreOS_${S24}_*) touch $DONE; exit 0 ;;
esac

suffix() { echo "$1" | sed 's/://g' | tr 'a-z' A-Z | cut -c7-12; }
MAC6=$(macaddr_add "$BASE" 2); MAC24=$(macaddr_add "$BASE" 3); MAC5=$(macaddr_add "$BASE" 4)
S6=$(suffix "$MAC6"); S5=$(suffix "$MAC5")

uci set wireless.radio0_band0.disabled='0'
uci set wireless.radio0_band0.channel='1'
# 2.4G is for compatibility (smart-home/IoT chips), not speed: Wi-Fi 6 at
# 20 MHz without EHT/MLO, no PMF (its SHA256 AKM breaks many IoT chips) and
# no low-ACK kick (sleeping IoT devices answer late and got dropped).
uci set wireless.radio0_band0.htmode='HE20'
uci set wireless.radio0_band0.noscan='1'
uci set wireless.default_radio0_band0.ssid="iStoreOS_${S24}_2.4G"
uci set wireless.default_radio0_band0.encryption='none'
uci set wireless.default_radio0_band0.ieee80211w='0'
uci set wireless.default_radio0_band0.disassoc_low_ack='0'
uci set wireless.radio0_band1.disabled='0'
uci set wireless.radio0_band1.channel='36'
uci set wireless.radio0_band1.htmode='EHT160'
uci set wireless.default_radio0_band1.ssid="iStoreOS_${S5}_5G"
uci set wireless.default_radio0_band1.encryption='none'
uci set wireless.radio0_band2.disabled='0'
uci set wireless.radio0_band2.channel='37'
uci set wireless.radio0_band2.htmode='EHT320'
uci set wireless.default_radio0_band2.ssid="iStoreOS_${S6}_6G"
uci set wireless.default_radio0_band2.encryption='owe'
uci set wireless.default_radio0_band2.ieee80211w='2'
uci set wireless.default_radio0_band2.wds='1'
# companions follow the factory SSIDs set above
uci -q delete wireless.owe_radio0_band0
uci -q delete wireless.owe_radio0_band1
owe_pair 0
owe_pair 1
touch /etc/sbe-wifi-width-v2
touch $DONE
uci commit wireless

# apply without tearing the whole radio down
/sbin/wifi up >/dev/null 2>&1
logger -t factory-wireless "applied per-unit factory SSID layout (${S24})"
exit 0
