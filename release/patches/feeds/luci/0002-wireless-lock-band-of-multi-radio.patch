+	// Hardware band of a multi-radio section, from the channel range the
+	// wifi detect script stored in 'channels' (e.g. 1-11, 36-165, 1-233).
+	getRadioBand: function(section_id) {
+		if (uci.get('wireless', section_id, 'radio') == null)
+			return null;
+
+		const nums = String(uci.get('wireless', section_id, 'channels') ?? '')
+			.split(/[^0-9]+/).filter(n => n.length).map(n => +n);
+
+		if (!nums.length)
+			return null;
+
+		const lo = Math.min(...nums), hi = Math.max(...nums);
+
+		if (hi <= 14)
+			return '2g';
+		if (lo >= 32 && hi <= 177)
+			return '5g';
+		if (hi > 177)
+			return '6g';
+
+		return null;
+	},
