From 9463017c11487600c5fcd96ffefe4c7a50137559 Mon Sep 17 00:00:00 2001
From: build-fix <build-fix@local>
Date: Thu, 5 Nov 2026 09:33:09 +0800
Subject: [PATCH] perl: build the target tree serially

Parallel module builds race: one job's pm_to_blib copy of lib/*.pm runs
while another module's Makefile.PL executes, and the loading module then
reads a partially written file. Observed failure on the target build:

  File/Path.pm did not return a true value at
  .../staging_dir/hostpkg/usr/lib/perl5/5.40.0/ExtUtils/MakeMaker.pm line 13.
  BEGIN failed--compilation aborted ...
  Unsuccessful Makefile.PL(cpan/bignum): code=65280 at make_ext.pl line 532.
  make[4]: *** [makefile:596: cpan/bignum/pm_to_blib] Error 2

'make depend' (kept) already covers the Debian bug 996953 config race;
forcing -j1 removes the pm_to_blib copy race deterministically.
---
 lang/perl/Makefile | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/lang/perl/Makefile b/lang/perl/Makefile
index 3212e90..2a34c77 100644
--- a/lang/perl/Makefile
+++ b/lang/perl/Makefile
@@ -119,7 +119,10 @@ endef
 define Build/Compile
 	# make depend is required to avoid race conditions: https://bugs.debian.org/cgi-bin/bugreport.cgi?bug=996953
 	+$(MAKE) -C $(PKG_BUILD_DIR) depend
-	+$(MAKE) $(PKG_JOBS) -C $(PKG_BUILD_DIR)
+	# Build serially: with parallel make, module pm_to_blib copies into lib/
+	# race other modules' Makefile.PL runs, which then load a partially
+	# written module and abort ("File/Path.pm did not return a true value").
+	+$(MAKE) -j1 -C $(PKG_BUILD_DIR)
 endef
 
 ifeq ($(CONFIG_arc),)
