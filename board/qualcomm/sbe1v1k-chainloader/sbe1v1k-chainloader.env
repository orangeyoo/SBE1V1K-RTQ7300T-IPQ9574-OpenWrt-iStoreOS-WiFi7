stdin=serial
stdout=serial
stderr=serial
bootdelay=8
loadaddr=0x60000000
recovery_addr=0x60000000
recovery_max=0x40000000
recovery_stream=0
recovery_debug=1
recovery_timeout=0
recovery_backend=mmc
recovery_mmcdev=0
recovery_part_kernel=0#kernel
recovery_part_rootfs=0#rootfs
recovery_part_data=0#rootfs_data
recovery_part_uboot=0#chainloader
aq_fw_part=0#ETHPHYFW
recovery_uboot_max=0x400000
recovery_kernel_pad=0x2000000
phy_aneg_timeout=4000
button_cmd_0_name=reset
button_cmd_0=http_recovery
tftp_recovery_serverip=192.168.255.2
tftp_recovery_file=firmware.bin
tftp_recovery_timeout=300
mmcdev=0
kernpart=kernel
root=/dev/mmcblk0p27
rootpart=/dev/mmcblk0p27
fstools_overlay_fstype=ext4
overlayargs=fstools_overlay_fstype=ext4
bootargs=console=ttyMSM0,115200n8 rootwait root=/dev/mmcblk0p27 fstools_overlay_fstype=ext4
# A full install is the only bootable SBE1V1K layout. Check every new
# partition's start/size before reading a kernel; never fall back to a vendor
# HLOS slot or an older tail layout.
detect_layout=mmc dev ${mmcdev}; setenv sbe_layout_valid 0; if part start mmc ${mmcdev} chainloader chainloader_start && part size mmc ${mmcdev} chainloader chainloader_size && itest.l ${chainloader_start} == 14022 && itest.l ${chainloader_size} == 2000 && part start mmc ${mmcdev} kernel kernel_start && part size mmc ${mmcdev} kernel kernel_size && itest.l ${kernel_start} == 16022 && itest.l ${kernel_size} == 10000 && part start mmc ${mmcdev} rootfs rootfs_start && part size mmc ${mmcdev} rootfs rootfs_size && itest.l ${rootfs_start} == 26022 && itest.l ${rootfs_size} == 200000 && part start mmc ${mmcdev} rootfs_data data_start && itest.l ${data_start} == 226022; then setenv kernpart kernel; setenv root /dev/mmcblk0p27; setenv rootpart /dev/mmcblk0p27; setenv fstools_overlay_fstype ext4; setenv overlayargs fstools_overlay_fstype=ext4; setenv sbe_layout_valid 1; fi
boot_openwrt=run detect_layout; if test ${sbe_layout_valid} = 1; then setenv bootargs console=ttyMSM0,115200n8 rootwait root=${rootpart} ${overlayargs}; mmc read ${loadaddr} ${kernel_start} ${kernel_size}; bootm ${loadaddr}; echo OpenWrt boot failed, starting HTTP recovery; http_recovery; else echo SBE1V1K full clean layout is missing or invalid; starting HTTP recovery; http_recovery; fi
bootcmd=run boot_openwrt
