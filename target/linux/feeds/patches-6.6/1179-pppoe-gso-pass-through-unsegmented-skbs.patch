From: SBE1V1K <build@localhost>
Subject: [PATCH] pppoe: GSO pass-through for skbs that need no segmentation

skb_mac_gso_segment() returns NULL when the inner GSO handler has
nothing to split (for TCP: payload no larger than one MSS); the caller
then transmits the original skb. pppoe_gso_segment() treated NULL as a
failure: it logged "pppoe segmentation failed" (some 350 times in half
an hour on a PPPoE WAN, accelerated LAN->WAN TCP) and returned without
undoing what it had changed, so the packet left with skb->protocol set
to the inner IP protocol, mac_len 0 and the network header on the IP
header. Real errors and non-IP payloads returned the same way.

Restore protocol, mac_len and network header on every early return and
only warn for real errors, with the error code and GSO type.

---
--- a/drivers/net/ppp/pppoe.c
+++ b/drivers/net/ppp/pppoe.c
@@ -535,7 +535,7 @@
 		skb->protocol = htons(ETH_P_IPV6);
 		break;
 	default:
-		goto out;
+		goto restore;
 	}
 
 	__skb_pull(skb, PPP_PROTO_LEN);
@@ -543,8 +543,18 @@
 
 	segs = skb_mac_gso_segment(skb, features);
 	if (IS_ERR_OR_NULL(segs)) {
-		pr_warn_ratelimited("%p: pppoe segmentation failed\n", skb);
-		goto out;
+		/* NULL is not an error: the inner GSO handler had nothing to
+		 * split (payload no larger than one MSS) and the caller sends
+		 * the original skb. It must leave here as it came in, with
+		 * its PPPoE protocol, mac_len and network header; this used
+		 * to warn "pppoe segmentation failed" hundreds of times an
+		 * hour and send such packets with the inner IP metadata.
+		 */
+		if (IS_ERR(segs))
+			pr_warn_ratelimited("pppoe: GSO segmentation failed: %ld (gso_type 0x%x, gso_size %u, len %u)\n",
+					    PTR_ERR(segs), skb_shinfo(skb)->gso_type,
+					    skb_shinfo(skb)->gso_size, skb->len);
+		goto restore;
 	}
 
 	skb = segs;
@@ -578,7 +588,13 @@
 		ph->length = htons(ip_len + PPP_PROTO_LEN);
 	} while ((skb = skb->next));
 
-out:
+	return segs;
+
+restore:
+	/* skb->data goes back to the MAC header in skb_mac_gso_segment() */
+	skb->protocol = protocol;
+	skb->mac_len = mac_len;
+	skb_set_network_header(skb, mac_len);
 	return segs;
 }
 
