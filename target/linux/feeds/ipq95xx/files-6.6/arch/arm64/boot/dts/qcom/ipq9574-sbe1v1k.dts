/* [OEM] EDMA loopback ring (one ring, queues 56-63) */
&{/soc@0/edma@3ab00000} {
	qcom,num_loopback_rings = <1>;
	qcom,txdesc_loopback_ring_id = <0>;
	qcom,txcmpl_loopback_ring_id = <0>;
	qcom,rxfill_loopback_ring_id = <0>;
	qcom,rxdesc_loopback_ring_id = <0>;
	qcom,loopback_queue_base = <56>;
	qcom,loopback_num_queues = <8>;
};

/* [OEM] eip197 rx interrupt CPUs: dma0-3 -> cpu3,2,1,0 (dma4-7 unchanged) */
&eip {
	dma0 {
		rx_cpu = /bits/ 8 <3>;
	};

	dma1 {
		rx_cpu = /bits/ 8 <2>;
	};

	dma2 {
		rx_cpu = /bits/ 8 <1>;
	};

	dma3 {
		rx_cpu = /bits/ 8 <0>;
	};
};
