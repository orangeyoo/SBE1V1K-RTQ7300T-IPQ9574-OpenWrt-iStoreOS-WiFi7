#!/bin/sh /etc/rc.common
# SBE1V1K: recover a wedged WAN transmit queue.
START=99
USE_PROCD=1

start_service() {
	local board enabled device iface
	read -r board 2>/dev/null < /tmp/sysinfo/board_name || return 0
	case "$board" in
		askey,sbe1v1k|orangeyoo,sbe1v1k|spectrum,sbe1v1k) ;;
		*) return 0 ;;
	esac

	config_load sbe-wan-txwatch
	config_get_bool enabled wan enabled 0
	[ "$enabled" = 1 ] || return 0
	config_get device wan device eth1
	config_get iface wan interface wan
	case "$device" in
		''|*[!a-zA-Z0-9_.-]*|.|..) return 1 ;;
	esac
	case "$iface" in
		''|*[!a-zA-Z0-9_]*) return 1 ;;
	esac
	procd_open_instance
	procd_set_param command /usr/sbin/sbe-wan-txwatch "$device" "$iface"
	procd_set_param respawn
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger sbe-wan-txwatch
}
